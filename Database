
CREATE DATABASE GrandVistaResort; 
USE GrandVistaResort;
 

CREATE TABLE Employees (
    emp_id       INT           AUTO_INCREMENT PRIMARY KEY,
    first_name   VARCHAR(100)  NOT NULL,
    last_name    VARCHAR(100)  NOT NULL,
    job_title    VARCHAR(50)   NOT NULL CHECK (job_title IN ('Director','Concierge','Housekeeper','Warden','Head Chef')),
    email_addr   VARCHAR(150)  NOT NULL UNIQUE,
    contact_no   VARCHAR(20),
    joining_date DATE          NOT NULL,
    base_salary  DECIMAL(10,2) NOT NULL CHECK (base_salary > 0),
    work_shift   VARCHAR(20)   NOT NULL CHECK (work_shift IN ('Daytime','Twilight','Overnight'))
);
 
CREATE TABLE Tier_Category (
    category_id  INT          AUTO_INCREMENT PRIMARY KEY,
    tier_name    VARCHAR(80)  NOT NULL UNIQUE,
    amenities    TEXT,
    nightly_rate DECIMAL(8,2) NOT NULL CHECK (nightly_rate > 0),
    adult_cap    INT          NOT NULL DEFAULT 2,
    child_cap    INT          NOT NULL DEFAULT 0
);
 
CREATE TABLE Suites (
    suite_id     INT          AUTO_INCREMENT PRIMARY KEY,
    door_number  VARCHAR(10)  NOT NULL UNIQUE,
    floor_level  INT          NOT NULL,
    category_id  INT          NOT NULL,
    hk_status    VARCHAR(20)  NOT NULL DEFAULT 'Vacant'
                     CHECK (hk_status IN ('Vacant','Inhabited','Service Mode','Allocated')),
    climate_ctrl TINYINT(1)   NOT NULL DEFAULT 1,
    broadband    TINYINT(1)   NOT NULL DEFAULT 1,
    smart_tv     TINYINT(1)   NOT NULL DEFAULT 1,
    veranda      TINYINT(1)   NOT NULL DEFAULT 0,
    CONSTRAINT fk_suite_tier FOREIGN KEY (category_id) REFERENCES Tier_Category(category_id)
        ON DELETE RESTRICT ON UPDATE CASCADE
);
 
CREATE TABLE Clients (
    client_id    INT          AUTO_INCREMENT PRIMARY KEY,
    first_name   VARCHAR(100) NOT NULL,
    last_name    VARCHAR(100) NOT NULL,
    email_addr   VARCHAR(150) NOT NULL UNIQUE,
    contact_no   VARCHAR(20)  NOT NULL,
    id_card      VARCHAR(20)  UNIQUE,
    origin       VARCHAR(80)  NOT NULL DEFAULT 'Pakistani',
    home_address VARCHAR(255),
    home_city    VARCHAR(100),
    registered_on DATE         NOT NULL
);

CREATE TABLE Bookings (
    booking_id   INT           AUTO_INCREMENT PRIMARY KEY,
    client_id    INT           NOT NULL,
    suite_id     INT           NOT NULL,
    emp_id       INT           NOT NULL,
    start_date   DATE          NOT NULL,
    end_date     DATE          NOT NULL,
    adult_count  INT           NOT NULL DEFAULT 1 CHECK (adult_count >= 1),
    child_count  INT           NOT NULL DEFAULT 0 CHECK (child_count >= 0),
    book_status  VARCHAR(20)   NOT NULL DEFAULT 'Approved'
                        CHECK (book_status IN ('Approved','Active','Concluded','Revoked')),
    remarks      TEXT,
    grand_total  DECIMAL(10,2) NOT NULL DEFAULT 0,
    logged_date  DATE          NOT NULL,
    CONSTRAINT fk_bk_client FOREIGN KEY (client_id) REFERENCES Clients(client_id) ON DELETE RESTRICT,
    CONSTRAINT fk_bk_suite  FOREIGN KEY (suite_id)  REFERENCES Suites(suite_id)  ON DELETE RESTRICT,
    CONSTRAINT fk_bk_emp    FOREIGN KEY (emp_id)    REFERENCES Employees(emp_id)  ON DELETE RESTRICT,
    CONSTRAINT chk_timeline CHECK (end_date > start_date)
);
 
CREATE TABLE Ledger (
    ledger_id    INT           AUTO_INCREMENT PRIMARY KEY,
    booking_id   INT           NOT NULL,
    amount_paid  DECIMAL(10,2) NOT NULL CHECK (amount_paid > 0),
    post_date    DATE          NOT NULL,
    pay_channel  VARCHAR(30)   NOT NULL
	CHECK (pay_channel IN ('Physical Cash','Visa Card','Master Card','Wire Transfer','E-Wallet')),
    pay_status   VARCHAR(20)   NOT NULL DEFAULT 'Settled'
                        CHECK (pay_status IN ('Settled','Awaiting','Reimbursed','Dropped')),
    gateway_ref  VARCHAR(100)  UNIQUE,
    CONSTRAINT fk_ledger_bk FOREIGN KEY (booking_id) REFERENCES Bookings(booking_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);
 
DELIMITER $$
 
CREATE TRIGGER trg_suite_on_booking
AFTER INSERT ON Bookings
FOR EACH ROW
BEGIN
    UPDATE Suites SET hk_status = 'Allocated'
    WHERE suite_id = NEW.suite_id;
END$$

CREATE TRIGGER trg_suite_on_active
AFTER UPDATE ON Bookings
FOR EACH ROW
BEGIN
    IF NEW.book_status = 'Active' AND OLD.book_status != 'Active' THEN
        UPDATE Suites SET hk_status = 'Inhabited'
        WHERE suite_id = NEW.suite_id;
    END IF;
END$$

CREATE TRIGGER trg_suite_on_cleanup
AFTER UPDATE ON Bookings
FOR EACH ROW
BEGIN
    IF (NEW.book_status = 'Concluded' OR NEW.book_status = 'Revoked')
       AND (OLD.book_status != 'Concluded' AND OLD.book_status != 'Revoked') THEN
        UPDATE Suites SET hk_status = 'Vacant'
        WHERE suite_id = NEW.suite_id;
    END IF;
END$$

CREATE TRIGGER trg_calculate_grand_total
BEFORE INSERT ON Bookings
FOR EACH ROW
BEGIN
    DECLARE stay_duration INT;
    DECLARE rate_per_night DECIMAL(8,2);
    SET stay_duration = DATEDIFF(NEW.end_date, NEW.start_date);
    
    SELECT nightly_rate INTO rate_per_night
    FROM Tier_Category tc
    JOIN Suites s ON s.category_id = tc.category_id
    WHERE s.suite_id = NEW.suite_id;
    
    SET NEW.grand_total = stay_duration * rate_per_night;
END$$
 
DELIMITER ;


CREATE OR REPLACE VIEW vw_Master_Bookings AS
SELECT
    b.booking_id,
    CONCAT(c.first_name,' ',c.last_name)  AS client_fullname,
    c.contact_no                           AS client_phone,
    st.door_number,
    tc.tier_name                           AS luxury_tier,
    b.start_date,
    b.end_date,
    DATEDIFF(b.end_date, b.start_date)     AS duration_nights,
    b.adult_count,
    b.child_count,
    b.book_status,
    b.grand_total,
    CONCAT(e.first_name,' ',e.last_name)  AS representative
FROM Bookings b
JOIN Clients   c  ON b.client_id   = c.client_id
JOIN Suites    st ON b.suite_id    = st.suite_id
JOIN Tier_Category tc ON st.category_id = tc.category_id
JOIN Employees e  ON b.emp_id      = e.emp_id;

CREATE OR REPLACE VIEW vw_Vacant_Suites AS
SELECT
    s.suite_id,
    s.door_number,
    s.floor_level,
    tc.tier_name,
    tc.nightly_rate,
    s.climate_ctrl,
    s.broadband,
    s.smart_tv,
    s.veranda
FROM Suites s
JOIN Tier_Category tc ON s.category_id = tc.category_id
WHERE s.hk_status = 'Vacant';

CREATE OR REPLACE VIEW vw_Financial_Ledger AS
SELECT
    l.ledger_id,
    b.booking_id,
    CONCAT(c.first_name,' ',c.last_name) AS client_fullname,
    st.door_number,
    b.grand_total                        AS deal_value,
    l.amount_paid                        AS collected_cash,
    l.pay_channel,
    l.post_date,
    l.pay_status,
    l.gateway_ref
FROM Ledger l
JOIN Bookings b ON l.booking_id = b.booking_id
JOIN Clients  c ON b.client_id  = c.client_id
JOIN Suites   st ON b.suite_id  = st.suite_id;



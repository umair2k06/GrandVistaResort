SELECT
    b.booking_id,
    CONCAT(c.first_name,' ',c.last_name) AS client,
    c.origin,
    st.door_number,
    tc.tier_name,
    b.start_date, b.end_date,
    DATEDIFF(b.end_date, b.start_date)   AS nights,
    b.grand_total,
    b.book_status,
    CONCAT(e.first_name,' ',e.last_name) AS managed_by
FROM Bookings b
JOIN Clients   c  ON b.client_id  = c.client_id
JOIN Suites    st ON b.suite_id   = st.suite_id
JOIN Tier_Category tc ON st.category_id = tc.category_id
JOIN Employees e  ON b.emp_id     = e.emp_id
ORDER BY b.start_date DESC;
SELECT
    tc.tier_name,
    COUNT(b.booking_id) AS transactional_volume,
    SUM(b.grand_total)  AS structural_yield,
    AVG(b.grand_total)  AS typical_deal_size,
    MAX(b.grand_total)  AS peak_performance,
    MIN(b.grand_total)  AS basement_valuation
FROM Tier_Category tc
JOIN Suites          st ON tc.category_id = st.category_id
JOIN Bookings        b  ON st.suite_id    = b.suite_id
GROUP BY tc.category_id, tc.tier_name
HAVING COUNT(b.booking_id) > 0
ORDER BY structural_yield DESC;
 

SELECT
    CONCAT(e.first_name,' ',e.last_name) AS agent_identity,
    e.job_title,
    e.work_shift,
    COUNT(b.booking_id)                  AS processed_accounts,
    SUM(b.grand_total)                   AS direct_monetary_contribution
FROM Employees e
LEFT JOIN Bookings b ON e.emp_id = b.emp_id
GROUP BY e.emp_id, e.first_name, e.last_name, e.job_title, e.work_shift
HAVING COUNT(b.booking_id) > 0
ORDER BY processed_accounts DESC;


SELECT
    CONCAT(c.first_name,' ',c.last_name) AS patron_profile,
    c.origin,
    c.home_city,
    (SELECT SUM(b2.grand_total)
     FROM Bookings b2 WHERE b2.client_id = c.client_id) AS total_investment
FROM Clients c
WHERE (SELECT COALESCE(SUM(b3.grand_total),0)
       FROM Bookings b3 WHERE b3.client_id = c.client_id)
    > (SELECT AVG(nested.aggregate_sum) FROM
          (SELECT SUM(b4.grand_total) AS aggregate_sum
           FROM Bookings b4 GROUP BY b4.client_id) nested)
ORDER BY total_investment DESC;


SELECT st.door_number, tc.tier_name, tc.nightly_rate, st.hk_status
FROM Suites st
JOIN Tier_Category tc ON st.category_id = tc.category_id
WHERE NOT EXISTS (
    SELECT 1 FROM Bookings b WHERE b.suite_id = st.suite_id
);


